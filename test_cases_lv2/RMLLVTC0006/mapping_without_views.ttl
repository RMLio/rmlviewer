@prefix : <http://example.org/> .
@prefix rml: <http://w3id.org/rml/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:mixedCSVSource a rml:InputLogicalSource ;
    rml:referenceFormulation rml:CSV ;
    rml:source [ a rml:RelativePathSource,
                rml:Source ;
            rml:path "people.csv" ;
            rml:root rml:MappingDirectory ] .

:triplesMapItem a rml:TriplesMap ;
    rml:logicalSource :mixedCSVView ;
    rml:predicateObjectMap [ rml:objectMap [ rml:reference "item.type" ] ;
            rml:predicate :hasType ],
        [ rml:objectMap [ rml:datatype xsd:integer ;
                    rml:reference "item.weight" ] ;
            rml:predicate :hasWeight ] ;
    rml:subjectMap [ rml:template "http://example.org/item_{#}_{item.#}" ] .

:mixedCSVView a rml:InputLogicalSource ;
    rml:referenceFormulation rml:CSV ;
    rml:source [ a rml:RelativePathSource,
                rml:Source ;
            rml:null "" ;
            rml:path "./view0.csv" ;
            rml:root rml:MappingDirectory ] .

