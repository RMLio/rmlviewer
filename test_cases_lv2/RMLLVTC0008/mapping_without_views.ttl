@prefix : <http://example.org/> .
@prefix rml: <http://w3id.org/rml/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:mixedJSONSource a rml:InputLogicalSource ;
    rml:iterator "$.people[*]" ;
    rml:referenceFormulation rml:JSONPath ;
    rml:source [ a rml:RelativePathSource,
                rml:Source ;
            rml:path "people.json" ;
            rml:root rml:MappingDirectory ] .

:triplesMapItem a rml:TriplesMap ;
    rml:logicalSource :mixedJSONView ;
    rml:predicateObjectMap [ rml:objectMap [ rml:reference "items.type" ] ;
            rml:predicate :hasType ],
        [ rml:objectMap [ rml:datatype xsd:integer ;
                    rml:reference "items.weight" ] ;
            rml:predicate :hasWeight ] ;
    rml:subjectMap [ rml:template "http://example.org/item_{#}_{items.#}" ] .

:mixedJSONView a rml:InputLogicalSource ;
    rml:referenceFormulation rml:CSV ;
    rml:source [ a rml:RelativePathSource,
                rml:Source ;
            rml:null "" ;
            rml:path "./view0.csv" ;
            rml:root rml:MappingDirectory ] .

