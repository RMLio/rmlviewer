@prefix : <http://example.org/> .
@prefix rml: <http://w3id.org/rml/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:csvSource a rml:InputLogicalSource ;
    rml:referenceFormulation rml:CSV ;
    rml:source [ a rml:RelativePathSource,
                rml:Source ;
            rml:path "people.csv" ;
            rml:root rml:MappingDirectory ] .

:jsonSource a rml:InputLogicalSource ;
    rml:iterator "$.people[*]" ;
    rml:referenceFormulation rml:JSONPath ;
    rml:source [ a rml:RelativePathSource,
                rml:Source ;
            rml:path "people.json" ;
            rml:root rml:MappingDirectory ] .

:jsonView a rml:InputLogicalSource ;
    rml:referenceFormulation rml:CSV ;
    rml:source [ a rml:RelativePathSource,
                rml:Source ;
            rml:null "" ;
            rml:path "./view0.csv" ;
            rml:root rml:MappingDirectory ] .

:triplesMapPerson a rml:TriplesMap ;
    rml:logicalSource :csvView ;
    rml:predicateObjectMap [ rml:objectMap [ rml:reference "name" ] ;
            rml:predicate :hasName ],
        [ rml:objectMap [ rml:datatype xsd:gYear ;
                    rml:reference "birthyear" ] ;
            rml:predicate :hasBirthyear ],
        [ rml:objectMap [ rml:parentTriplesMap :triplesMapItem ] ;
            rml:predicate :hasItem ] ;
    rml:subjectMap [ rml:template "http://example.org/person/{name}" ] .

:triplesMapItem a rml:TriplesMap ;
    rml:logicalSource :csvView ;
    rml:predicateObjectMap [ rml:objectMap [ rml:reference "item_type" ] ;
            rml:predicate :hasType ],
        [ rml:objectMap [ rml:datatype xsd:integer ;
                    rml:reference "item_weight" ] ;
            rml:predicate :hasWeight ] ;
    rml:subjectMap [ rml:template "http://example.org/person/{name}/item/{item_type}" ] .

:csvView a rml:InputLogicalSource ;
    rml:referenceFormulation rml:CSV ;
    rml:source [ a rml:RelativePathSource,
                rml:Source ;
            rml:null "" ;
            rml:path "./view1.csv" ;
            rml:root rml:MappingDirectory ] .

