@prefix dct: <http://purl.org/dc/terms/> .
@prefix moveUp: <http://moveUp.care/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rml: <http://w3id.org/rml/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.com/PatientTriplesMap> a rml:TriplesMap ;
    rml:logicalSource <http://example.com/json> ;
    rml:predicateObjectMap [ rml:objectMap [ rml:parentTriplesMap <http://example.com/ResponseTriplesMap> ] ;
            rml:predicate moveUp:hasQuestionnaireResponse ] ;
    rml:subjectMap [ rml:template "http://moveUp.care/patient/{patientId}" ] .

<http://example.com/jsonView> a rml:LogicalSource ;
    rml:referenceFormulation rml:CSV ;
    rml:source [ a rml:RelativePathSource,
                rml:Source ;
            rml:null "" ;
            rml:path "./view0.csv" ;
            rml:root rml:MappingDirectory ] .

<http://example.com/AnswerTriplesMap> a rml:TriplesMap ;
    rml:logicalSource <http://example.com/json> ;
    rml:predicateObjectMap [ rml:objectMap [ rml:reference "sections.questions.answers.display" ] ;
            rml:predicate rdfs:label ],
        [ rml:objectMap [ rml:reference "sections.questions.type" ] ;
            rml:predicate moveUp:answerType ],
        [ rml:objectMap [ rml:reference "sections.questions.answers.ansCode" ] ;
            rml:predicate moveUp:answerValue ],
        [ rml:objectMap [ rml:datatype xsd:decimal ;
                    rml:reference "sections.questions.answers.ansDecimal" ] ;
            rml:predicate moveUp:answerValue ],
        [ rml:objectMap [ rml:parentTriplesMap <http://example.com/QuestionTriplesMap> ] ;
            rml:predicate moveUp:question ] ;
    rml:subjectMap [ rml:template "http://moveUp.care/responses/{identifiers.responseSystem}-{identifiers.responseId}/answer/{questionnaireId}-{sections.id}-{sections.questions.id}" ] .

<http://example.com/QuestionTriplesMap> a rml:TriplesMap ;
    rml:logicalSource <http://example.com/json> ;
    rml:predicateObjectMap [ rml:objectMap [ rml:reference "sections.questions.label" ] ;
            rml:predicate rdfs:label ],
        [ rml:objectMap [ rml:reference "sections.questions.type" ] ;
            rml:predicate moveUp:questionType ],
        [ rml:objectMap [ rml:parentTriplesMap <http://example.com/SectionsTriplesMap> ] ;
            rml:predicate moveUp:partOfSection ] ;
    rml:subjectMap [ rml:template "http://moveUp.care/question/{sections.id}-{sections.questions.id}" ] .

<http://example.com/ResponseTriplesMap> a rml:TriplesMap ;
    rml:logicalSource <http://example.com/json> ;
    rml:predicateObjectMap [ rml:objectMap [ rml:reference "status" ] ;
            rml:predicate moveUp:status ],
        [ rml:objectMap [ rml:reference "creationDate" ] ;
            rml:predicate dct:created ],
        [ rml:objectMap [ rml:parentTriplesMap <http://example.com/QuestionnaireTriplesMap> ] ;
            rml:predicate moveUp:isResponseFor ],
        [ rml:objectMap [ rml:parentTriplesMap <http://example.com/AnswerTriplesMap> ] ;
            rml:predicate moveUp:hasAnswer ] ;
    rml:subjectMap [ rml:template "http://moveUp.care/responses/{identifiers.responseSystem}-{identifiers.responseId}" ] .

<http://example.com/SectionsTriplesMap> a rml:TriplesMap ;
    rml:logicalSource <http://example.com/json> ;
    rml:predicateObjectMap [ rml:objectMap [ rml:reference "sections.label" ] ;
            rml:predicate rdfs:label ],
        [ rml:objectMap [ rml:parentTriplesMap <http://example.com/QuestionnaireTriplesMap> ] ;
            rml:predicate moveUp:partOfQuestionnaire ] ;
    rml:subjectMap [ rml:template "http://moveUp.care/sections/{sections.id}" ] .

<http://example.com/QuestionnaireTriplesMap> a rml:TriplesMap ;
    rml:logicalSource <http://example.com/json> ;
    rml:predicateObjectMap [ rml:objectMap [ rml:reference "questionnaireLabel" ] ;
            rml:predicate rdfs:label ] ;
    rml:subjectMap [ rml:template "http://moveUp.care/questionnaires/{questionnaireId}" ] .

<http://example.com/json> a rml:LogicalSource ;
    rml:iterator "$.[*]" ;
    rml:referenceFormulation rml:JSONPath ;
    rml:source [ rml:path "questionnaireResponse.json" ;
            rml:root rml:MappingDirectory ] .

