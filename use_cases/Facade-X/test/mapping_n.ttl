@prefix rml: <http://w3id.org/rml/>.
@prefix fx: <http://sparql.xyz/facade-x/ns/>.
@prefix xyz: <http://sparql.xyz/facade-x/data/>.
@prefix : <http://example.com/>.

:ls1 a rml:LogicalSource;
    rml:source _:b0;
    rml:referenceFormulation rml:CSV.
_:b0 a rml:Source, rml:RelativePathSource;
    rml:root rml:MappingDirectory;
    rml:path "some.csv".
:lv1 a rml:logicalView;
    rml:viewOn :ls1;
    rml:field _:b3, _:b2, _:b1.
_:b1 a rml:ExpressionField;
    rml:fieldName "id";
    rml:reference "id".
_:b2 a rml:ExpressionField;
    rml:fieldName "name";
    rml:reference "name".
_:b3 a rml:ExpressionField;
    rml:fieldName "height_inches";
    rml:reference "height_inches".
:tm1 a rml:TriplesMap;
    rml:logicalSource :lv1;
    rml:subjectMap _:b4;
    rml:predicateObjectMap _:b4-0, _:b5.
_:b4 a rml:TermMap, rml:SubjectMap;
    rml:template "lv1";
    rml:termType rml:BlankNode.
_:b6 a rml:TermMap, rml:PredicateMap;
    rml:template "http://www.w3.org/1999/02/22-rdf-syntax-ns#_{#}".
_:b5 a rml:PredicateObjectMap;
    rml:predicateMap _:b6;
    rml:objectMap _:b7.
_:b7 a rml:TermMap, rml:ObjectMap;
    rml:reference "#";
    rml:termType rml:BlankNode.
:tm2 a rml:TriplesMap;
    rml:logicalSource :lv1;
    rml:subjectMap _:b8;
    rml:predicateObjectMap _:b13, _:b11, _:b9.
_:b8 a rml:TermMap, rml:SubjectMap;
    rml:reference "#";
    rml:termType rml:BlankNode.
_:b9 a rml:PredicateObjectMap;
    rml:predicateMap _:b9-3;
    rml:objectMap _:b10.
_:b10 a rml:TermMap, rml:ObjectMap;
    rml:reference "height_inches".
_:b11 a rml:PredicateObjectMap;
    rml:predicateMap _:b11-4;
    rml:objectMap _:b12.
_:b12 a rml:TermMap, rml:ObjectMap;
    rml:reference "id".
_:b13 a rml:PredicateObjectMap;
    rml:predicateMap _:b13-5;
    rml:objectMap _:b14.
_:b14 a rml:TermMap, rml:ObjectMap;
    rml:reference "name".
_:b4-0 a rml:PredicateObjectMap;
    rml:predicateMap :tm1-1;
    rml:objectMap :tm1-2.
:tm1-1 a rml:TermMap, rml:PredicateMap;
    rml:constant <http://www.w3.org/1999/02/22-rdf-syntax-ns#type>.
:tm1-2 a rml:TermMap, rml:ObjectMap;
    rml:constant fx:root.
_:b9-3 a rml:TermMap, rml:PredicateMap;
    rml:constant xyz:height_inches.
_:b11-4 a rml:TermMap, rml:PredicateMap;
    rml:constant xyz:id.
_:b13-5 a rml:TermMap, rml:PredicateMap;
    rml:constant xyz:name.

