@prefix rml: <http://w3id.org/rml/> .
@prefix : <http://example.org/> .

:xmlSource a rml:LogicalSource ;
  rml:source [
    a rml:RelativePathSource , rml:Source ;
    rml:root rml:MappingDirectory ;
    rml:path "people.xml" ;
  ] ;
  rml:referenceFormulation rml:XPath ;
  rml:iterator "//name".

:xmlView a rml:LogicalView ;
  rml:viewOn :xmlSource ;
  rml:field [
    a rml:ExpressionField ;
    rml:fieldName "name" ;
    rml:reference "./text()" ;
  ] ;
  rml:field [
    a rml:ExpressionField ;
    rml:fieldName "id" ;
    rml:reference "../value/text()" ;
  ] .

:triplesMapPerson a rml:TriplesMap ;
  rml:logicalSource :xmlView ;
  rml:subjectMap [
    rml:template "http://example.org/person/{#}" ;
  ] ;
  rml:predicateObjectMap [
    rml:predicate :hasId ;
    rml:objectMap [
      rml:reference "id" ;
    ] ;
  ] ; 
  rml:predicateObjectMap [
    rml:predicate :hasName ;
    rml:objectMap [
      rml:reference "name" ;
    ] ;
  ] .
